{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "championtokens",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "exclude": [
      ".git/**",
      "node_modules/**",
      ".github/**",
      ".wrangler/**",
      "scratch/**",
      "api/**",
      "functions/**",
      "netlify/**",
      "worker.js",
      "wrangler.jsonc",
      "package.json",
      "package-lock.json"
    ]
  }
}
